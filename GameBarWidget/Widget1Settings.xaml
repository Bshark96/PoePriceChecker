<Page
    x:Class="GameBarWidget.Widget1Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#131b26"
    ContextFlyout="{x:Null}"
    MinWidth="340"
    MinHeight="400">

    <Page.Resources>
        <!-- Checkbox & ToggleSwitch Emerald Green Theme -->
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#22c55e"/>
        <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="#16a34a"/>
        <SolidColorBrush x:Key="CheckBoxPointerOverBackgroundThemeBrush" Color="#1e293b"/>
        <SolidColorBrush x:Key="CheckBoxPressedBackgroundThemeBrush" Color="#0f172a"/>
        <SolidColorBrush x:Key="CheckBoxSelectedBackgroundThemeBrush" Color="#16a34a"/>
        <SolidColorBrush x:Key="CheckBoxSelectedBorderThemeBrush" Color="#22c55e"/>
        <SolidColorBrush x:Key="CheckBoxSelectedPointerOverBackgroundThemeBrush" Color="#22c55e"/>
        <SolidColorBrush x:Key="CheckBoxSelectedPointerOverBorderThemeBrush" Color="#4ade80"/>
        <SolidColorBrush x:Key="CheckBoxSelectedPressedBackgroundThemeBrush" Color="#15803d"/>
        <SolidColorBrush x:Key="CheckBoxSelectedPressedBorderThemeBrush" Color="#15803d"/>
        <SolidColorBrush x:Key="CheckBoxSelectedForegroundThemeBrush" Color="#ffffff"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#16a34a"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#22c55e"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#15803d"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#ffffff"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#ffffff"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#ffffff"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#0f172a"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#1e293b"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#0f172a"/>
        <SolidColorBrush x:Key="CheckBoxCheckBorderBrushUnchecked" Color="#334155"/>
        <SolidColorBrush x:Key="CheckBoxCheckBorderBrushChecked" Color="#22c55e"/>
        <SolidColorBrush x:Key="CheckBoxCheckBorderBrushCheckedPointerOver" Color="#4ade80"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#16a34a"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#22c55e"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#15803d"/>
    </Page.Resources>

    <Grid Padding="14">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Settings Form -->
            <RowDefinition Height="*"/>
            <!-- Footer Action -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" BorderBrush="#22384e" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="8" Height="8" CornerRadius="4" Background="#22c55e" VerticalAlignment="Center"/>
                <TextBlock Text="POE1 OVERLAY SETTINGS" 
                           FontSize="13" 
                           FontWeight="Bold" 
                           Foreground="#f8fafc" 
                           VerticalAlignment="Center"/>
                <Border Background="#1f3044" 
                        BorderBrush="#2d4560" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="5,1" 
                        VerticalAlignment="Center">
                    <TextBlock Text="GAME BAR NATIVE" 
                               FontSize="9" 
                               FontWeight="Bold" 
                               Foreground="#4ade80"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- SETTINGS FORM (SCROLLABLE) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <!-- Section 1: Official Trade Settings -->
                <TextBlock Text="OFFICIAL TRADE SETTINGS" FontSize="11" FontWeight="Bold" Foreground="#4ade80"/>

                <!-- Official Path of Exile Account Session Authentication -->
                <StackPanel Spacing="4">
                    <TextBlock Text="PathOfExile.com Account Session:" FontSize="11" Foreground="#cbd5e1"/>
                    <Border Background="#111924" BorderBrush="#22384e" BorderThickness="1" CornerRadius="4" Padding="10">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border x:Name="AuthStatusBadge" Background="#1f3044" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="AuthStatusText" Text="Not Logged In" FontSize="10" FontWeight="Bold" Foreground="#94a3b8"/>
                                </Border>
                                <TextBlock x:Name="AccountDisplayNameText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="InAppLoginBtn" Content="Log In with Browser (Auto-Detect POESESSID)" Click="InAppLoginBtn_Click" Background="#2563eb" Foreground="#ffffff" FontSize="11" FontWeight="SemiBold" CornerRadius="4" Padding="8,5" HorizontalAlignment="Stretch"/>
                                <Button Grid.Column="1" x:Name="OpenBrowserBtn" Content="Open in Browser" Click="OpenBrowserBtn_Click" Background="#1e2c3d" Foreground="#94a3b8" FontSize="11" CornerRadius="4" Padding="8,5" Margin="6,0,0,0"/>
                                <Button Grid.Column="2" x:Name="ClearSessionBtn" Content="Clear" Click="ClearSessionBtn_Click" Background="#7f1d1d" Foreground="#f87171" FontSize="11" CornerRadius="4" Padding="8,5" Margin="6,0,0,0" Visibility="Collapsed"/>
                            </Grid>

                            <!-- Login Status Prompt -->
                            <Border x:Name="LoginStatusCard" Background="#0b1118" BorderBrush="#2563eb" BorderThickness="1" CornerRadius="4" Padding="8" Visibility="Collapsed">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ProgressRing x:Name="LoginProgressRing" Width="14" Height="14" IsActive="True" Foreground="#38bdf8"/>
                                        <TextBlock x:Name="LoginPromptText" Text="Browser login window opened... Log in with your PoE/Steam account." FontSize="10" Foreground="#38bdf8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Cloudflare, Steam OAuth, and 2FA are handled natively in the Chromium window. POESESSID will synchronize automatically." FontSize="9" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="3">
                                <TextBlock Text="POESESSID Cookie (Required for Hideout Travel &amp; Rate Limits):" FontSize="10" Foreground="#cbd5e1"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="PoeSessIdBox" ContextFlyout="{x:Null}" AllowFocusOnInteraction="True" IsTabStop="True" PlaceholderText="Paste POESESSID manually" Background="#0b1118" Foreground="#f8fafc" BorderBrush="#22384e" FontSize="11" Padding="6,4"/>
                                    <Button Grid.Column="1" x:Name="PasteSessionBtn" Content="Paste from Clipboard" Click="PasteSessionBtn_Click" Background="#1e2c3d" Foreground="#38bdf8" FontSize="10" Padding="8,4" Margin="6,0,0,0" CornerRadius="3"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="Log in using the button above to auto-detect your session, or copy POESESSID manually from your browser." FontSize="9" Foreground="#94a3b8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Active League (Auto-Fetched from GGG) -->
                <StackPanel Spacing="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Active Challenge League:" FontSize="11" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Refresh Leagues" Click="RefreshLeaguesBtn_Click" Background="#1e2c3d" Foreground="#4ade80" FontSize="9" Padding="6,2" CornerRadius="3"/>
                    </Grid>
                    <ComboBox x:Name="LeagueCombo" Background="#111924" Foreground="#f8fafc" BorderBrush="#22384e" FontSize="11" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Standard" IsSelected="True"/>
                        <ComboBoxItem Content="Hardcore"/>
                        <ComboBoxItem Content="Settlers"/>
                        <ComboBoxItem Content="Settlers Hardcore"/>
                    </ComboBox>
                    <TextBlock Text="Prices and trade queries will be filtered EXCLUSIVELY for the selected league." FontSize="9" Foreground="#94a3b8"/>
                </StackPanel>

                <!-- Account Name -->
                <StackPanel Spacing="3">
                    <TextBlock Text="Account Name (Optional):" FontSize="11" Foreground="#cbd5e1"/>
                    <TextBox x:Name="AccountNameBox" ContextFlyout="{x:Null}" AllowFocusOnInteraction="True" IsTabStop="True" Background="#111924" Foreground="#f8fafc" BorderBrush="#22384e" FontSize="11" Padding="6,4"/>
                    <TextBlock Text="Used to identify and highlight your own listings." FontSize="9" Foreground="#94a3b8"/>
                </StackPanel>

                <!-- Trade Mode Filter (Only in Settings) -->
                <StackPanel Spacing="3">
                    <TextBlock Text="Trade Mode:" FontSize="11" Foreground="#cbd5e1"/>
                    <ComboBox x:Name="OnlineStatusCombo" SelectedIndex="0" Background="#111924" Foreground="#f8fafc" BorderBrush="#22384e" FontSize="11" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Only async (Default)"/>
                        <ComboBoxItem Content="Any (Both async and not async)"/>
                        <ComboBoxItem Content="Only sync"/>
                    </ComboBox>
                    <TextBlock Text="Only async filters for Faustus instant buyout / securable listings. Any includes both async and direct whisper listings. Only sync filters for active in-game sellers." FontSize="9" Foreground="#94a3b8" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Modifier Roll Tolerance -->
                <StackPanel Spacing="3">
                    <TextBlock Text="Modifier Tolerance Range (% below roll):" FontSize="11" Foreground="#cbd5e1"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="25" Value="10" StepFrequency="5" ValueChanged="ToleranceSlider_ValueChanged"/>
                        <TextBlock Grid.Column="1" x:Name="ToleranceLabel" Text="-10%" FontSize="11" FontWeight="Bold" Foreground="#4ade80" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Auto-Query Official Trade -->
                <CheckBox x:Name="AutoSearchCheck" 
                          Content="Automatically query official trade API upon hotkey" 
                          IsChecked="True" 
                          FontSize="11" 
                          Foreground="#cbd5e1"/>

                <Border BorderBrush="#1e2c3d" BorderThickness="0,0,0,1" Margin="0,4"/>

                <!-- Section 2: Overlay & Hotkey Settings -->
                <TextBlock Text="OVERLAY &amp; HOTKEY BEHAVIOR" FontSize="11" FontWeight="Bold" Foreground="#4ade80"/>

                <!-- Daemon Hotkey Selection -->
                <StackPanel Spacing="3">
                    <TextBlock Text="Daemon Price Check Hotkey:" FontSize="11" Foreground="#cbd5e1"/>
                    <ComboBox x:Name="HotkeyCombo" SelectedIndex="0" Background="#111924" Foreground="#f8fafc" BorderBrush="#22384e" FontSize="11" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="CTRL+D (Default)"/>
                        <ComboBoxItem Content="CTRL+E"/>
                        <ComboBoxItem Content="CTRL+F"/>
                        <ComboBoxItem Content="ALT+A"/>
                        <ComboBoxItem Content="ALT+D"/>
                        <ComboBoxItem Content="ALT+E"/>
                        <ComboBoxItem Content="ALT+F"/>
                    </ComboBox>
                    <TextBlock Text="In-game hotkey: automatically copies highlighted item (CTRL+ALT+C) &amp; queries price." FontSize="9" Foreground="#94a3b8"/>
                </StackPanel>

                <!-- Live Search Hotkey Selection -->
                <StackPanel Spacing="3">
                    <TextBlock Text="LIVE SEARCH Hotkey (Future Feature):" FontSize="11" Foreground="#cbd5e1"/>
                    <ComboBox x:Name="LiveSearchHotkeyCombo" SelectedIndex="0" Background="#111924" Foreground="#f8fafc" BorderBrush="#22384e" FontSize="11" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="ALT+A (Default)"/>
                        <ComboBoxItem Content="ALT+D"/>
                        <ComboBoxItem Content="ALT+F"/>
                        <ComboBoxItem Content="ALT+E"/>
                        <ComboBoxItem Content="CTRL+L"/>
                    </ComboBox>
                    <TextBlock Text="In-game hotkey for LIVE SEARCH: opens dedicated Live Search widget layout window." FontSize="9" Foreground="#94a3b8" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Display Duration -->
                <StackPanel Spacing="3">
                    <TextBlock Text="Card Display Duration (Seconds before minimize):" FontSize="11" Foreground="#cbd5e1"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="DurationSlider" Minimum="3" Maximum="30" Value="10" StepFrequency="1" ValueChanged="DurationSlider_ValueChanged"/>
                        <TextBlock Grid.Column="1" x:Name="DurationLabel" Text="10s" FontSize="11" FontWeight="Bold" Foreground="#4ade80" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER: SAVE BUTTON -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="SaveSettingsBtn" 
                    Content="Save &amp; Apply All Settings" 
                    Click="SaveSettingsBtn_Click" 
                    Background="#16a34a" 
                    Foreground="#ffffff" 
                    FontSize="11" 
                    FontWeight="Bold" 
                    HorizontalAlignment="Stretch" 
                    Padding="10,6" 
                    CornerRadius="4"/>
        </Grid>
    </Grid>
</Page>
