  <!-- Automatically build HotkeyDaemon desktop companion and guarantee AppX packaging -->
  <Target Name="BuildHotkeyDaemon" BeforeTargets="BeforeBuild;BeforeGenerateAppxPackageRecipe;GetPackagingOutputs;AssignTargetPaths">
    <MSBuild Projects="..\HotkeyDaemon\HotkeyDaemon.csproj" 
             Properties="Configuration=$(Configuration);Platform=AnyCPU" 
             Targets="Build" />
    <ItemGroup>
      <_DaemonBinaries Include="..\HotkeyDaemon\bin\$(Configuration)\net8.0-windows10.0.19041.0\**\*.*" />
      <Content Include="@(_DaemonBinaries)">
        <Link>%(RecursiveDir)%(FileName)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
    <Copy SourceFiles="@(_DaemonBinaries)"
          DestinationFolder="$(TargetDir)%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

