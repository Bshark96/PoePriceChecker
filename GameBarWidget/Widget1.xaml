<Page
    x:Class="GameBarWidget.Widget1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#131b26"
    ContextFlyout="{x:Null}"
    MinWidth="380"
    MinHeight="320">

    <Page.Resources>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#16a34a"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#22c55e"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#15803d"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#ffffff"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#ffffff"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#ffffff"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#0f172a"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#1e293b"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#0f172a"/>
        <SolidColorBrush x:Key="CheckBoxCheckBorderBrushUnchecked" Color="#334155"/>
        <SolidColorBrush x:Key="CheckBoxCheckBorderBrushChecked" Color="#22c55e"/>
        <SolidColorBrush x:Key="CheckBoxCheckBorderBrushCheckedPointerOver" Color="#4ade80"/>
    </Page.Resources>

    <Grid Padding="6">
        <Grid.RowDefinitions>
            <!-- Top Application Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area: Price Check Overlay Card -->
            <RowDefinition Height="*"/>
            <!-- Footer Status & Health -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP APPLICATION HEADER -->
        <Grid Grid.Row="0" x:Name="TopHeaderGrid" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <Border Width="7" Height="7" CornerRadius="3.5" Background="#22c55e" VerticalAlignment="Center"/>
                <TextBlock Text="POE1 OVERLAY" 
                           FontSize="11" 
                           FontWeight="Bold" 
                           Foreground="#f1f5f9" 
                           VerticalAlignment="Center"/>
                <Border Background="#1f3044" 
                        BorderBrush="#2d4560" 
                        BorderThickness="1" 
                        CornerRadius="3" 
                        Padding="3,0.5" 
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadge" 
                               Text="CTRL+D ACTIVE" 
                               FontSize="8.5" 
                               FontWeight="Bold" 
                               Foreground="#4ade80"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="PriceCheckTabBtn" 
                        Content="PRICE CHECK" 
                        Click="PriceCheckTabBtn_Click" 
                        Background="#22c55e" 
                        Foreground="#ffffff" 
                        FontWeight="Bold" 
                        FontSize="9" 
                        Padding="6,2" 
                        CornerRadius="3"/>
                <Button x:Name="LiveSearchTabBtn" 
                        Content="LIVE SEARCH" 
                        Click="LiveSearchTabBtn_Click" 
                        Background="#1f3044" 
                        Foreground="#94a3b8" 
                        FontWeight="Bold" 
                        FontSize="9" 
                        Padding="6,2" 
                        CornerRadius="3"/>
                <Button x:Name="DismissHeaderBtn" 
                        Content="Dismiss [ESC]" 
                        Click="DismissBtn_Click" 
                        Background="#2d1d24" 
                        Foreground="#f87171" 
                        BorderBrush="#7f1d1d" 
                        BorderThickness="1" 
                        FontSize="9.5" 
                        Padding="5,1.5" 
                        CornerRadius="3"/>
            </StackPanel>
        </Grid>

        <!-- MAIN CONTENT AREA: ITEM PRICE CHECK OVERLAY -->
        <Grid Grid.Row="1">

            <!-- ITEM PRICE CHECK VIEW -->
            <Border x:Name="PriceCheckView" 
                    Background="#182333" 
                    BorderBrush="#22384e" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="5">
                        <!-- Item Header Box -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border x:Name="ItemRarityBadge" 
                                            Background="#78350f" 
                                            CornerRadius="2" 
                                            Padding="3,0.5">
                                        <TextBlock x:Name="ItemRarityText" 
                                                   Text="UNIQUE" 
                                                   FontSize="8.5" 
                                                   FontWeight="Bold" 
                                                   Foreground="#fde047"/>
                                    </Border>
                                    <TextBlock x:Name="ItemLevelText" 
                                               Text="Item lvl: 85" 
                                               FontSize="9.5" 
                                               Foreground="#94a3b8" 
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ItemSocketText" 
                                               Text="" 
                                               FontSize="9.5" 
                                               Foreground="#38bdf8" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ItemNameText" 
                                           Text="Mageblood" 
                                           FontSize="13.5" 
                                           FontWeight="Bold" 
                                           Foreground="#f8fafc"/>
                                <TextBlock x:Name="ItemBaseTypeText" 
                                           Text="Heavy Belt" 
                                           FontSize="10" 
                                           Foreground="#cbd5e1"/>
                            </StackPanel>

                            <!-- Benchmark Price Display -->
                            <Border Grid.Column="1" 
                                    Background="#111924" 
                                    BorderBrush="#22384e" 
                                    BorderThickness="1" 
                                    CornerRadius="3" 
                                    Padding="6,2" 
                                    VerticalAlignment="Top">
                                <StackPanel HorizontalAlignment="Right" Spacing="0.5">
                                    <TextBlock Text="Market Summary" FontSize="8" Foreground="#94a3b8" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="BenchmarkDivineText" Text="200.0 Div" FontSize="12.5" FontWeight="Bold" Foreground="#4ade80" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="BenchmarkChaosText" Text="≈ 32,000 Chaos" FontSize="9" Foreground="#cbd5e1" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Modifier Checkboxes Area -->
                        <Border Background="#111924" 
                                BorderBrush="#1e2c3d" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="5,4">
                            <StackPanel Spacing="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="MODIFIER FILTERS" 
                                                   FontSize="8.5" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#94a3b8" 
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="ToggleCompactModsBtn" 
                                                Content="Collapse All" 
                                                Click="ToggleCompactModsBtn_Click" 
                                                Background="#1e293b" 
                                                Foreground="#94a3b8" 
                                                BorderBrush="#334155" 
                                                BorderThickness="1" 
                                                FontSize="8" 
                                                FontWeight="SemiBold" 
                                                Padding="4,1" 
                                                CornerRadius="2"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button x:Name="OpenBrowserBtn" 
                                                Content="Open in Trade" 
                                                Click="OpenBrowserBtn_Click" 
                                                Background="#0f2942" 
                                                Foreground="#38bdf8" 
                                                BorderBrush="#0369a1" 
                                                BorderThickness="1" 
                                                FontSize="8.5" 
                                                FontWeight="SemiBold" 
                                                Padding="5,1" 
                                                CornerRadius="2"
                                                Visibility="Collapsed"/>
                                        <Button x:Name="UpdatePricesBtn" 
                                                Content="Search / Refresh" 
                                                Click="UpdatePricesBtn_Click" 
                                                Background="#1e3a5f" 
                                                Foreground="#38bdf8" 
                                                BorderBrush="#0284c7" 
                                                BorderThickness="1" 
                                                FontSize="8.5" 
                                                FontWeight="SemiBold" 
                                                Padding="5,1" 
                                                CornerRadius="2"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Trade Filters Bar: Corrupted Selector -->
                                <Border Background="#090e15" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="3" Padding="4,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="FILTERS" FontSize="8" FontWeight="SemiBold" Foreground="#64748b" VerticalAlignment="Center"/>

                                        <!-- Corrupted Filter Selector -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Corrupted:" FontSize="8" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            <Button x:Name="CorruptAnyBtn" Content="Any" FontSize="8" Height="18" Padding="4,0" Background="#1e293b" Foreground="#f8fafc" Click="CorruptFilterBtn_Click" Tag="any"/>
                                            <Button x:Name="CorruptYesBtn" Content="Yes" FontSize="8" Height="18" Padding="4,0" Background="#0f172a" Foreground="#94a3b8" Click="CorruptFilterBtn_Click" Tag="true"/>
                                            <Button x:Name="CorruptNoBtn" Content="No" FontSize="8" Height="18" Padding="4,0" Background="#0f172a" Foreground="#94a3b8" Click="CorruptFilterBtn_Click" Tag="false"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="ModContainer" Spacing="1"/>
                            </StackPanel>
                        </Border>

                        <!-- Official Market Listings Box -->
                        <Border Background="#111924" 
                                BorderBrush="#1e2c3d" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="5,4">
                            <StackPanel Spacing="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ListingsHeaderTitle" Text="OFFICIAL TRADE MARKET" FontSize="8.5" FontWeight="SemiBold" Foreground="#94a3b8"/>
                                    <TextBlock Grid.Column="1" x:Name="MarketStatusText" Text="Status: Online" FontSize="8.5" Foreground="#22c55e"/>
                                </Grid>

                                <StackPanel x:Name="ListingsContainer" Spacing="2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- LIVE SEARCH OVERLAY VIEW -->
            <Border x:Name="LiveSearchView" 
                    Background="#182333" 
                    BorderBrush="#22384e" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="6"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6">
                        <!-- Live Search Header & URL Entry Box -->
                        <Border Background="#111924" BorderBrush="#22384e" BorderThickness="1" CornerRadius="4" Padding="6">
                            <StackPanel Spacing="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#22c55e" VerticalAlignment="Center"/>
                                        <TextBlock Text="OFFICIAL TRADE LIVE SEARCH" FontSize="10.5" FontWeight="Bold" Foreground="#4ade80"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" x:Name="LiveSearchConnectionStatus" Text="Ready" FontSize="9.5" FontWeight="Bold" Foreground="#94a3b8"/>
                                </Grid>

                                <!-- Trade Link Input Bar -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LiveSearchUrlBox" 
                                             ContextFlyout="{x:Null}" 
                                             PlaceholderText="Paste trade link: pathofexile.com/trade/search/Standard/xyz123" 
                                             Background="#0b1118" 
                                             Foreground="#f8fafc" 
                                             BorderBrush="#22384e" 
                                             FontSize="10" 
                                             Padding="6,3"/>
                                    <Button Grid.Column="1" x:Name="PasteLiveUrlBtn" Content="Paste" Click="PasteLiveUrlBtn_Click" Background="#1e2c3d" Foreground="#38bdf8" FontSize="10" Padding="8,3" Margin="4,0,0,0" CornerRadius="3"/>
                                </Grid>

                                <!-- Max Price Threshold Bar -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Max Price Limit:" FontSize="9.5" Foreground="#cbd5e1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" x:Name="LiveSearchMaxPriceBox" ContextFlyout="{x:Null}" PlaceholderText="No limit" Background="#0b1118" Foreground="#f8fafc" BorderBrush="#22384e" FontSize="10" Padding="6,3"/>
                                    <ComboBox Grid.Column="2" x:Name="LiveSearchCurrencyCombo" SelectedIndex="0" Background="#0b1118" Foreground="#f8fafc" BorderBrush="#22384e" FontSize="10" Margin="4,0,0,0" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Divine"/>
                                        <ComboBoxItem Content="Chaos"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" x:Name="AddLiveSearchBtn" Content="+ Add Search" Click="AddLiveSearchBtn_Click" Background="#16a34a" Foreground="#ffffff" FontSize="10" FontWeight="Bold" Padding="8,3" Margin="6,0,0,0" CornerRadius="3"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Active Monitored Searches -->
                        <StackPanel Spacing="3">
                            <TextBlock Text="ACTIVE MONITORED SEARCHES" FontSize="9.5" FontWeight="Bold" Foreground="#4ade80"/>
                            <StackPanel x:Name="ActiveQueriesContainer" Spacing="2">
                                <TextBlock Text="No active live searches. Paste a trade link above to monitor listings." FontSize="9" Foreground="#94a3b8" Margin="2,2,0,2"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Incoming Live Stream Listings -->
                        <StackPanel Spacing="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="LIVE LISTINGS STREAM" FontSize="9.5" FontWeight="Bold" Foreground="#4ade80" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="ClearLiveListingsBtn" Content="Clear" Click="ClearLiveListingsBtn_Click" Background="#1e2c3d" Foreground="#94a3b8" FontSize="8.5" Padding="5,1" CornerRadius="2"/>
                            </Grid>
                            <StackPanel x:Name="LiveListingsContainer" Spacing="3">
                                <TextBlock Text="Incoming live search items will appear here in real time." FontSize="9" Foreground="#94a3b8" Margin="2,2,0,2"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Live Search Diagnostics & Debug Log Box -->
                        <Border Background="#090e15" BorderBrush="#1e2c3d" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,4,0,0">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="5" Height="5" CornerRadius="2.5" Background="#38bdf8"/>
                                        <TextBlock Text="LIVE SEARCH DIAGNOSTICS LOG" FontSize="9" FontWeight="Bold" Foreground="#38bdf8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button x:Name="CopyDebugLogBtn" Content="Copy Log" Click="CopyDebugLogBtn_Click" Background="#1e2c3d" Foreground="#38bdf8" FontSize="8" Padding="5,1" CornerRadius="2"/>
                                        <Button x:Name="ClearDebugLogBtn" Content="Clear" Click="ClearDebugLogBtn_Click" Background="#1e2c3d" Foreground="#94a3b8" FontSize="8" Padding="5,1" CornerRadius="2"/>
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer Height="110" VerticalScrollBarVisibility="Auto" Background="#05080c" CornerRadius="3" Padding="4">
                                    <TextBox x:Name="LiveSearchDebugLogText" 
                                             IsReadOnly="True" 
                                             TextWrapping="Wrap" 
                                             AcceptsReturn="True" 
                                             Background="Transparent" 
                                             Foreground="#38bdf8" 
                                             FontFamily="Consolas" 
                                             FontSize="8.5" 
                                             BorderThickness="0"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 3RD VIEW: LIVE NOTIFICATION OVERLAY VIEW -->
            <Border x:Name="LiveNotificationView" 
                    Background="#182333" 
                    BorderBrush="#22384e" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="6"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6">
                        <!-- Notification Header Banner -->
                        <Border Background="#111924" BorderBrush="#22384e" BorderThickness="1" CornerRadius="4" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#22c55e" VerticalAlignment="Center"/>
                                    <TextBlock Text="LIVE TRADE NOTIFICATION (VIEW 3)" FontSize="10.5" FontWeight="Bold" Foreground="#4ade80"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="ClearNotificationBtn" Content="Clear" Click="ClearNotificationBtn_Click" Background="#1e2c3d" Foreground="#94a3b8" FontSize="9" Padding="6,2" CornerRadius="3"/>
                            </Grid>
                        </Border>

                        <!-- Notification Container for Streamed Items -->
                        <StackPanel x:Name="NotificationCardsContainer" Spacing="6">
                            <TextBlock Text="No active live notifications. New incoming items will display here automatically." FontSize="9.5" Foreground="#94a3b8" Margin="4"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER: COUNTDOWN & HEALTH STATUS -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Auto Minimize Progress Bar -->
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <ProgressBar x:Name="CountdownBar" 
                             Value="100" 
                             Maximum="100" 
                             Height="4" 
                             Foreground="#22c55e" 
                             Background="#1e293b"/>
                <TextBlock x:Name="CountdownText" 
                           Text="Auto-minimizing in 10.0s (Hover to pause)" 
                           FontSize="9" 
                           Foreground="#94a3b8"/>
            </StackPanel>

            <!-- Rate Limit Health Gauge -->
            <Border Grid.Column="1" 
                    Background="#111924" 
                    BorderBrush="#22384e" 
                    BorderThickness="1" 
                    CornerRadius="3" 
                    Padding="6,2" 
                    Margin="8,0,0,0">
                <TextBlock x:Name="RateLimitStatusText" 
                           Text="RATE LIMIT: NORMAL (12/6s)" 
                           FontSize="9" 
                           FontWeight="SemiBold" 
                           Foreground="#4ade80"/>
            </Border>
        </Grid>
    </Grid>
</Page>
