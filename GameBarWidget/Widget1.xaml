<Page
    x:Class="GameBarWidget.Widget1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#131b26"
    MinWidth="380"
    MinHeight="320">

    <Page.Resources>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#16a34a"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#22c55e"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#15803d"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#ffffff"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#ffffff"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#ffffff"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#0f172a"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#1e293b"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#0f172a"/>
        <SolidColorBrush x:Key="CheckBoxCheckBorderBrushUnchecked" Color="#334155"/>
        <SolidColorBrush x:Key="CheckBoxCheckBorderBrushChecked" Color="#22c55e"/>
        <SolidColorBrush x:Key="CheckBoxCheckBorderBrushCheckedPointerOver" Color="#4ade80"/>
    </Page.Resources>

    <Grid Padding="6">
        <Grid.RowDefinitions>
            <!-- Top Application Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area: Price Check Overlay Card -->
            <RowDefinition Height="*"/>
            <!-- Footer Status & Health -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP APPLICATION HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <Border Width="7" Height="7" CornerRadius="3.5" Background="#22c55e" VerticalAlignment="Center"/>
                <TextBlock Text="POE1 OVERLAY" 
                           FontSize="11" 
                           FontWeight="Bold" 
                           Foreground="#f1f5f9" 
                           VerticalAlignment="Center"/>
                <Border Background="#1f3044" 
                        BorderBrush="#2d4560" 
                        BorderThickness="1" 
                        CornerRadius="3" 
                        Padding="3,0.5" 
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadge" 
                               Text="CTRL+D ACTIVE" 
                               FontSize="8.5" 
                               FontWeight="Bold" 
                               Foreground="#4ade80"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="ToHideoutHeaderBtn" 
                        Content="To Hideout" 
                        Click="ToHideoutBtn_Click" 
                        Background="#162c20" 
                        Foreground="#4ade80" 
                        BorderBrush="#22c55e" 
                        BorderThickness="1" 
                        FontSize="9.5" 
                        Padding="5,1.5" 
                        CornerRadius="3"/>

                <Button x:Name="DismissHeaderBtn" 
                        Content="Dismiss [ESC]" 
                        Click="DismissBtn_Click" 
                        Background="#2d1d24" 
                        Foreground="#f87171" 
                        BorderBrush="#7f1d1d" 
                        BorderThickness="1" 
                        FontSize="9.5" 
                        Padding="5,1.5" 
                        CornerRadius="3"/>
            </StackPanel>
        </Grid>

        <!-- MAIN CONTENT AREA: ITEM PRICE CHECK OVERLAY -->
        <Grid Grid.Row="1">

            <!-- ITEM PRICE CHECK VIEW -->
            <Border x:Name="PriceCheckView" 
                    Background="#182333" 
                    BorderBrush="#22384e" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="5">
                        <!-- Item Header Box -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border x:Name="ItemRarityBadge" 
                                            Background="#78350f" 
                                            CornerRadius="2" 
                                            Padding="3,0.5">
                                        <TextBlock x:Name="ItemRarityText" 
                                                   Text="UNIQUE" 
                                                   FontSize="8.5" 
                                                   FontWeight="Bold" 
                                                   Foreground="#fde047"/>
                                    </Border>
                                    <TextBlock x:Name="ItemLevelText" 
                                               Text="Item lvl: 85" 
                                               FontSize="9.5" 
                                               Foreground="#94a3b8" 
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ItemSocketText" 
                                               Text="" 
                                               FontSize="9.5" 
                                               Foreground="#38bdf8" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ItemNameText" 
                                           Text="Mageblood" 
                                           FontSize="13.5" 
                                           FontWeight="Bold" 
                                           Foreground="#f8fafc"/>
                                <TextBlock x:Name="ItemBaseTypeText" 
                                           Text="Heavy Belt" 
                                           FontSize="10" 
                                           Foreground="#cbd5e1"/>
                            </StackPanel>

                            <!-- Benchmark Price Display -->
                            <Border Grid.Column="1" 
                                    Background="#111924" 
                                    BorderBrush="#22384e" 
                                    BorderThickness="1" 
                                    CornerRadius="3" 
                                    Padding="6,2" 
                                    VerticalAlignment="Top">
                                <StackPanel HorizontalAlignment="Right" Spacing="0.5">
                                    <TextBlock Text="Market Summary" FontSize="8" Foreground="#94a3b8" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="BenchmarkDivineText" Text="200.0 Div" FontSize="12.5" FontWeight="Bold" Foreground="#4ade80" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="BenchmarkChaosText" Text="≈ 32,000 Chaos" FontSize="9" Foreground="#cbd5e1" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Modifier Checkboxes Area -->
                        <Border Background="#111924" 
                                BorderBrush="#1e2c3d" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="5,4">
                            <StackPanel Spacing="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="MODIFIER FILTERS" 
                                                   FontSize="8.5" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#94a3b8" 
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="ToggleCompactModsBtn" 
                                                Content="Collapse All" 
                                                Click="ToggleCompactModsBtn_Click" 
                                                Background="#1e293b" 
                                                Foreground="#94a3b8" 
                                                BorderBrush="#334155" 
                                                BorderThickness="1" 
                                                FontSize="8" 
                                                FontWeight="SemiBold" 
                                                Padding="4,1" 
                                                CornerRadius="2"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button x:Name="OpenBrowserBtn" 
                                                Content="Open in Trade" 
                                                Click="OpenBrowserBtn_Click" 
                                                Background="#0f2942" 
                                                Foreground="#38bdf8" 
                                                BorderBrush="#0369a1" 
                                                BorderThickness="1" 
                                                FontSize="8.5" 
                                                FontWeight="SemiBold" 
                                                Padding="5,1" 
                                                CornerRadius="2"
                                                Visibility="Collapsed"/>
                                        <Button x:Name="UpdatePricesBtn" 
                                                Content="Search / Refresh" 
                                                Click="UpdatePricesBtn_Click" 
                                                Background="#1e3a5f" 
                                                Foreground="#38bdf8" 
                                                BorderBrush="#0284c7" 
                                                BorderThickness="1" 
                                                FontSize="8.5" 
                                                FontWeight="SemiBold" 
                                                Padding="5,1" 
                                                CornerRadius="2"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Trade Filters Bar: Corrupted Selector -->
                                <Border Background="#090e15" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="3" Padding="4,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="FILTERS" FontSize="8" FontWeight="SemiBold" Foreground="#64748b" VerticalAlignment="Center"/>

                                        <!-- Corrupted Filter Selector -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Corrupted:" FontSize="8" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            <Button x:Name="CorruptAnyBtn" Content="Any" FontSize="8" Height="18" Padding="4,0" Background="#1e293b" Foreground="#f8fafc" Click="CorruptFilterBtn_Click" Tag="any"/>
                                            <Button x:Name="CorruptYesBtn" Content="Yes" FontSize="8" Height="18" Padding="4,0" Background="#0f172a" Foreground="#94a3b8" Click="CorruptFilterBtn_Click" Tag="true"/>
                                            <Button x:Name="CorruptNoBtn" Content="No" FontSize="8" Height="18" Padding="4,0" Background="#0f172a" Foreground="#94a3b8" Click="CorruptFilterBtn_Click" Tag="false"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="ModContainer" Spacing="1"/>
                            </StackPanel>
                        </Border>

                        <!-- Official Market Listings Box -->
                        <Border Background="#111924" 
                                BorderBrush="#1e2c3d" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="5,4">
                            <StackPanel Spacing="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ListingsHeaderTitle" Text="OFFICIAL TRADE MARKET" FontSize="8.5" FontWeight="SemiBold" Foreground="#94a3b8"/>
                                    <TextBlock Grid.Column="1" x:Name="MarketStatusText" Text="Status: Online" FontSize="8.5" Foreground="#22c55e"/>
                                </Grid>

                                <StackPanel x:Name="ListingsContainer" Spacing="2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- FOOTER: COUNTDOWN & HEALTH STATUS -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Auto Minimize Progress Bar -->
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <ProgressBar x:Name="CountdownBar" 
                             Value="100" 
                             Maximum="100" 
                             Height="4" 
                             Foreground="#22c55e" 
                             Background="#1e293b"/>
                <TextBlock x:Name="CountdownText" 
                           Text="Auto-minimizing in 10.0s (Hover to pause)" 
                           FontSize="9" 
                           Foreground="#94a3b8"/>
            </StackPanel>

            <!-- Rate Limit Health Gauge -->
            <Border Grid.Column="1" 
                    Background="#111924" 
                    BorderBrush="#22384e" 
                    BorderThickness="1" 
                    CornerRadius="3" 
                    Padding="6,2" 
                    Margin="8,0,0,0">
                <TextBlock x:Name="RateLimitStatusText" 
                           Text="RATE LIMIT: NORMAL (12/6s)" 
                           FontSize="9" 
                           FontWeight="SemiBold" 
                           Foreground="#4ade80"/>
            </Border>
        </Grid>
    </Grid>
</Page>
